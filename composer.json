{
    "name": "outbox/laravel-outbox",
    "description": "A small transactional outbox for Laravel with recoverable database leases.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "nesbot/carbon": "^3.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "LaravelOutbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelOutbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelOutbox\\OutboxServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src config database tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
